# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai

# AI / LLM Configuration (optional)
# Max output tokens per AI request (sent as "max_tokens" to the provider)
# AI_MAX_TOKENS=2000
# Total HTTP timeout seconds for one AI call (includes streaming response read)
# AI_TIMEOUT_SECONDS=120

# Data Encryption
DATA_ENCRYPTION_KEY=your-secret-encryption-key-here

# Secret Encryption (AI Model & Telegram Agent Keys)
SECRET_ENCRYPTION_KEY=your-secret-encryption-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_DEBUG=false
GAS_PAYER_PRIVATE_KEY=
GAS_SPONSORSHIP_ETH=0.0
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-key-here
ARBITRUM_CHAIN_ID=42161
ARBITRUM_USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Database Configuration (choose one)
# SQLite (local deployment)
DATABASE_URL=config.db

# PostgreSQL/Supabase (cloud deployment)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nofx
# SUPABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

HYPERLIQUID_TESTNET=false
